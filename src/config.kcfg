<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >

<!--
SPDX-FileCopyrightText: Carl Schwan <carl@carlschwan.eu>
SPDX-License-Identifier: CC0-1.0
-->
  <kcfgfile name="arianna" />
  <include>QStandardPaths</include>
  <group name="General">
    <entry name="bookLocations" type="StringList">
      <label>Location where to search for books</label>
      <code>
      QStringList defaultLocations;
      defaultLocations = QStandardPaths::standardLocations(QStandardPaths::DocumentsLocation);
      defaultLocations &lt;&lt; QStandardPaths::standardLocations(QStandardPaths::DownloadLocation);
      defaultLocations &lt;&lt; QStringLiteral("%1/books").arg(QStandardPaths::standardLocations(QStandardPaths::GenericDataLocation).constFirst());
      </code>
      <default code="true">defaultLocations</default>
    </entry>
  </group>
  <group name="Appearance">
    <entry name="defaultFont" type="Font">
      <label>Default font</label>
      <code>
      QFont generalFont = QFont(QStringLiteral("serif"), 12);
      generalFont.setStyleName(QStringLiteral("Regular"));
      </code>
      <default code="true">generalFont</default>
    </entry>
    <entry name="usePublisherFont" type="bool">
      <label>Use publisher font</label>
      <default>false</default>
    </entry>
    <entry name="invert" type="bool">
      <label>Invert colors</label>
      <default>false</default>
    </entry>
    <entry name="kdeTheming" type="bool">
      <label>KDE Theming</label>
      <default>true</default>
    </entry>
    <entry name="readerTheme" type="Enum">
      <label>Reader theme</label>
      <choices>
        <choice name="Normal" />
        <choice name="Inverse" />
        <choice name="System" />
      </choices>
      <default>System</default>
    </entry>
    <entry name="readerPageMode" type="Enum">
      <label>Default reader page view</label>
      <choices>
        <choice name="SinglePage" />
        <choice name="TwoPage" />
      </choices>
      <default>TwoPage</default>
    </entry>
    <entry name="readerBackgroundPath" type="String">
      <label>Reader background image path</label>
      <default></default>
    </entry>
    <entry name="justify" type="bool">
      <label>Justify text</label>
      <default>true</default>
    </entry>
    <entry name="hyphenate" type="bool">
      <label>Hyphenate text</label>
      <default>false</default>
    </entry>
    <entry name="spacing" type="double">
      <label>Line-height</label>
      <default>1.5</default>
    </entry>
    <entry name="fontSize" type="int">
      <label>Font size</label>
      <default>12</default>
    </entry>
    <entry name="brightness" type="double">
      <label>Brightness</label>
      <default>1</default>
    </entry>
    <entry name="maxWidth" type="int">
      <label>Max width</label>
      <default>1400</default>
    </entry>
    <entry name="margin" type="int">
      <label>Margin</label>
      <default>40</default>
    </entry>
    <entry name="showProgress" type="bool">
      <label>Show progress</label>
      <default>true</default>
    </entry>
    <entry name="libraryZoomLevel" type="double">
      <label>Library zoom level</label>
      <default>1.0</default>
    </entry>
  </group>
  <group name="TranslatorEngine">
    <entry name="translatorEngine" type="Enum">
      <label>Translation engine</label>
      <choices>
        <choice name="Google" />
        <choice name="DeepL" />
      </choices>
      <default>Google</default>
    </entry>
    <entry name="googleApiKey" type="String">
      <label>Google Translate API key</label>
    </entry>
    <entry name="deeplApiKey" type="String">
      <label>DeepL API key</label>
    </entry>
    <entry name="targetLanguage" type="String">
      <label>Translation target language</label>
      <default>DE</default>
    </entry>
  </group>
  <group name="Editor">
    <entry name="editorCommand" type="String">
      <label>External editor command</label>
      <default>sigil</default>
    </entry>
    <entry name="editorStartWithTextCommand" type="String">
      <label>External editor command for selected text</label>
      <default>/opt/calibre/ebook-edit</default>
    </entry>
    <entry name="pdfEditorCommand" type="String">
      <label>External PDF editor command</label>
      <default></default>
    </entry>
    <entry name="epubCheckCommand" type="String">
      <label>EPUB check command</label>
      <default>epubcheck</default>
    </entry>
    <entry name="pdfCheckCommand" type="String">
      <label>PDF check command</label>
      <default></default>
    </entry>
    <entry name="editorPath" type="String">
      <label>External editor path</label>
      <default></default>
    </entry>
  </group>
  <group name="BookDelivery">
    <entry name="bookServerAddress" type="String">
      <label>Book server address</label>
      <default>127.0.0.1</default>
    </entry>
    <entry name="bookServerPort" type="int">
      <label>Book server port</label>
      <default>45961</default>
    </entry>
    <entry name="calibreLibraryFolder" type="String">
      <label>Calibre Library Folder</label>
      <default></default>
    </entry>
    <entry name="bookResourceMode" type="String">
      <label>EPUB resource delivery mode</label>
      <default>auto</default>
    </entry>
    <entry name="bookReferencingMode" type="String">
      <label>EPUB reference delivery mode</label>
      <default>reader</default>
    </entry>
    <entry name="pdfWatermarkFilterMode" type="String">
      <label>PDF watermark filter mode</label>
      <default>never</default>
    </entry>
    <entry name="pdfWatermarkFilterEnabled" type="bool">
      <label>Remove PDF watermark before reading</label>
      <default>false</default>
    </entry>
    <entry name="pdfWatermarkFilterPattern" type="String">
      <label>PDF watermark marker</label>
      <default>/Private /WatermarkDemo</default>
    </entry>
  </group>
</kcfg>
